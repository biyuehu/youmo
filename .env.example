# 百度贴吧登录凭证（必需）
BDUSS=

# 贴吧过滤配置（可选）
# FILTER_MODE=include             # 过滤模式: include(仅签到列表中的吧) / exclude(排除列表中的吧)
# FILTER_LIST=贴吧A,贴吧B,贴吧C   # 过滤列表: 英文逗号分隔的吧名，完全匹配

# 批量签到配置
BATCH_SIZE=5         # 每批签到的贴吧数量
BATCH_INTERVAL=500   # 批次间隔(毫秒)

# 重试机制配置
MAX_RETRIES=3        # 最大重试次数
RETRY_INTERVAL=5000  # 重试间隔(毫秒)

# 通知功能配置
ENABLE_NOTIFY=false             # 是否启用通知推送

# 通知相关环境变量(可选)
# Maki酱
# MAKI_URL=http://127.0.0.1:720
# MAKI_TOKEN=

# Server酱
# SERVERCHAN_KEY=

# Bark
# BARK_KEY=

# Telegram
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# 钉钉
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=

# 企业微信
# WECOM_KEY=

# PushPlus
# PUSHPLUS_TOKEN= 